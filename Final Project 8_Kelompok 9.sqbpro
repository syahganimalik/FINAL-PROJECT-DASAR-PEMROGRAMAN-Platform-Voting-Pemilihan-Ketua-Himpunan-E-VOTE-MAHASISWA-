-- DATABASE E-VOTE HIMPUNAN MAHASISWA TEKNIK INDUSTRI (ANGKATAN 26)
-- ==========================================

CREATE TABLE IF NOT EXISTS pemilih (
    nim TEXT PRIMARY KEY,
    nama TEXT NOT NULL,
    program_studi TEXT NOT NULL,
    angkatan INTEGER NOT NULL,
    sudah_memilih INTEGER DEFAULT 0,
    tanggal_vote TEXT
);

CREATE TABLE IF NOT EXISTS kandidat (
    id_kandidat INTEGER PRIMARY KEY AUTOINCREMENT,
    nama_calon TEXT NOT NULL,
    program_studi TEXT NOT NULL,
    angkatan INTEGER NOT NULL,
    visi TEXT NOT NULL,
    misi TEXT NOT NULL,
    total_suara INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS admin (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS pengaturan_pemilu (
    id INTEGER PRIMARY KEY,
    status_pemilu TEXT NOT NULL
);

-- Akun Default Admin
INSERT OR IGNORE INTO admin (id, username, password) 
VALUES (1, 'admin', 'admin123');

-- Status Awal Pemilu
INSERT OR IGNORE INTO pengaturan_pemilu (id, status_pemilu) 
VALUES (1, 'AKTIF');

-- Reset &amp; Isi Data 3 Kandidat (Angkatan 2026)
DELETE FROM kandidat;
INSERT INTO kandidat (id_kandidat, nama_calon, program_studi, angkatan, visi, misi, total_suara) VALUES 
(1, 'Dion Imanuel Putra', 'Teknik Industri', 2026, 'Mewujudkan Himpunan Mahasiswa Teknik Industri yang inovatif, adaptif, dan berdaya saing.', '1. Meningkatkan kompetensi keilmuan Teknik Industri\n2. Memperluas jejaring kolaborasi industri\n3. Transparansi dan efisiensi tata kelola organisasi', 0),
(2, 'Reza Ahmad', 'Teknik Industri', 2026, 'Membawa Himpunan Mahasiswa Teknik Industri menuju sistem kerja yang efektif dan berdampak.', '1. Optimalisasi sistem kerja organisasi\n2. Mendorong inovasi dan riset mahasiswa\n3. Meningkatkan kepedulian sosial masyarakat', 0),
(3, 'Kezia Awwliya', 'Teknik Industri', 2026, 'Menjadikan Himpunan Mahasiswa Teknik Industri lebih solid, produktif, dan prestatif.', '1. Memperkuat solidaritas antar angkatan\n2. Menghadirkan program kerja berkualitas\n3. Pengembangan soft skill dan kepemimpinan', 0);

-- Reset &amp; Isi 5 Data Pemilih Awal (Dimas, Rio, Satria, Hilman, Gifari - Awalan NIM 26)
DELETE FROM pemilih;
INSERT INTO pemilih (nim, nama, program_studi, angkatan, sudah_memilih, tanggal_vote) VALUES
